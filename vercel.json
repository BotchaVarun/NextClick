{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ],
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "wsgi.py"
    }
  }
}
